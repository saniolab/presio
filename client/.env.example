VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=<your-publishable-key>

# Dev only: start signed in as a fake user (skips real auth) to test logged-in UI
# VITE_DEV_USER=dev@example.com

# Error tracking (Sentry or self-hosted GlitchTip). Leave empty to disable.
# VITE_SENTRY_DSN=https://<key>@<host>/<project>

# OAuth buttons (baked in at build time). Rebuild after changing.
# In docker compose these default to GITHUB_ENABLED / AUTHENTIK_ENABLED.
# VITE_AUTH_GITHUB=false
# VITE_AUTH_AUTHENTIK=true

# Marketing chrome (homepage pitch, newsletter, install prompt, wordmark).
# Default on. Set false to hide it. Rebuild after changing.
# VITE_BRANDING=true

# End Presentation deletes the deck by default. Set false to only stop the
# live session (viewers disconnect; PDF and recents stay). Rebuild after changing.
# VITE_END_DELETES=true
