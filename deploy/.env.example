############
# Domains — set these to YOUR real, externally-resolvable URLs.
#   APP      → where the Presio app is served (presio.example.com)
#   SUPABASE → where the Supabase API gateway (Kong) is served
#
# APP_HOST / SUPABASE_HOST are the BARE hostnames (no scheme) used by the
# Traefik proxy's Host() routing rules; they must match the host part of
# SITE_URL / SUPABASE_PUBLIC_URL below.
#
# IMPORTANT: SUPABASE_PUBLIC_URL is used both by the browser AND by the Presio
# server to build the public PDF URLs handed to viewers, so it MUST be a real
# domain that resolves from outside the stack. Plain `http://localhost:8000`
# only works for throwaway single-host testing.
############
APP_HOST=presio.xyz
SUPABASE_HOST=supabase.presio.xyz
SUPABASE_PUBLIC_URL=https://supabase.presio.xyz
API_EXTERNAL_URL=https://supabase.presio.xyz
SITE_URL=https://presio.xyz
# Comma-separated extra OAuth redirect targets (include localhost for dev).
# Wildcards matter: OAuth logins pass the user's current page (e.g.
# /s/ABC123?role=controller) as the redirect target, and GoTrue falls back to
# SITE_URL (the home page) for any URL not matched by this list.
ADDITIONAL_REDIRECT_URLS=https://presio.xyz/**,https://staging.presio.xyz/**,http://localhost:5173/**

# One-time code length in auth emails (GoTrue caps this at 10).
MAILER_OTP_LENGTH=10

# Browsers send an Origin header even on same-origin fetch/WebSocket requests,
# so this must be set to the app URL. Only add extra origins (comma-separated)
# if the client is hosted on a separate domain.
ALLOWED_ORIGIN=https://presio.xyz
# URL of the self-hosted Umami instance — added to the script-src CSP so the
# tracking script is allowed to load. Leave empty to disable.
ANALYTICS_URL=https://analytics.presio.xyz

############
# Observability
# - SENTRY_DSN / VITE_SENTRY_DSN: error tracking for the server and client.
#   Point them at Sentry's SaaS or a self-hosted GlitchTip. Leave empty to
#   disable. VITE_SENTRY_DSN is baked into the client bundle at build time.
# - UPTIME_HOST: bare hostname Traefik routes to the self-hosted Uptime Kuma
#   dashboard. After first boot, add a monitor for https://${APP_HOST}/healthz.
############
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
UPTIME_HOST=uptime.presio.xyz

############
# Core secrets — CHANGE ALL OF THESE
############
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Legacy HS256 API keys derived from JWT_SECRET (see the generate-keys helper).
# ANON_KEY is also used as the client's VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY.
ANON_KEY=paste-the-generated-anon-key-here
SERVICE_ROLE_KEY=paste-the-generated-service-role-key-here
PRESIO_SERVICE_API_KEY=change-this-to-a-long-random-service-key
PRESIO_HANDOFF_JWT_SECRET=change-this-to-a-separate-long-random-jwt-secret
PRESIO_HANDOFF_JWT_ISSUER=https://courses.example.com

# Opaque (sb_publishable_/sb_secret_) keys — optional, leave blank to use the
# legacy keys above.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Supabase Studio dashboard login (https://supabase.example.com).
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-this-dashboard-password

# Used internally by Realtime / Supavisor / Studio-meta — change these too.
SECRET_KEY_BASE=change-this-to-a-64-char-random-string-aaaaaaaaaaaaaaaaaaaaaaaaaa
VAULT_ENC_KEY=change-this-32-character-key-min
PG_META_CRYPTO_KEY=change-this-encryption-key-32-chars-min

############
# Auth — OAuth + email/password
#
# Callback for every OAuth / OIDC app (GitHub, Authentik, …):
#   ${API_EXTERNAL_URL}/auth/v1/callback
# i.e. https://supabase.example.com/auth/v1/callback
############
GITHUB_ENABLED=true
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret

# Authentik (OIDC). Registered as GoTrue custom provider custom:authentik
# (not Keycloak — that slot hardcodes /protocol/openid-connect/* paths).
# AUTHENTIK_URL is the issuer from Authentik's OpenID Configuration, e.g.
# https://authentik.example.com/application/o/presio/
AUTHENTIK_ENABLED=false
AUTHENTIK_CLIENT_ID=your-authentik-client-id
AUTHENTIK_SECRET=your-authentik-client-secret
AUTHENTIK_URL=

# Client marketing chrome (homepage pitch, newsletter, wordmark). Baked in at
# build time like VITE_AUTH_*. Default on; set false for a white-label embed.
VITE_BRANDING=true

# End Presentation deletes the deck by default. Set false to only stop the
# live session (viewers disconnect; PDF and recents stay). Rebuild after changing.
# VITE_END_DELETES=true

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

# Keep true so invited users can log in with email/password (and so Studio
# invites work). This is the GoTrue email provider, not public self-signup.
ENABLE_EMAIL_SIGNUP=true
# Public "Need an account? Sign up" in the login dialog. Leave false: create
# people in Authentik (SSO) or invite them from Supabase Studio. Do not set
# DISABLE_SIGNUP=true — that also blocks first-time Authentik login.
ENABLE_PUBLIC_SIGNUP=false
# false = signups must confirm via email; requires working SMTP_* below
# (e.g. Resend: host smtp.resend.com, port 465, user "resend", pass = API key).
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
SMTP_ADMIN_EMAIL=admin@presio.xyz
SMTP_HOST=smtp.presio.xyz
SMTP_PORT=2500
SMTP_USER=noreply@presio.xyz
SMTP_PASS=noreply@presio.xyz
SMTP_SENDER_NAME=Presio
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# Phone auth — unused by Presio, left at upstream defaults.
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

############
# Storage (MinIO-backed). GLOBAL_S3_BUCKET is the single MinIO bucket that
# holds all objects; the logical "presentations" bucket lives inside it and is
# created by dbschema.sql.
############
MINIO_ROOT_USER=presio-storage
MINIO_ROOT_PASSWORD=change-this-minio-password
GLOBAL_S3_BUCKET=presio-storage
REGION=us-east-1
STORAGE_TENANT_ID=presio
# S3 protocol endpoint creds (Supabase's own S3 API; unused by Presio but the
# storage service still reads them).
S3_PROTOCOL_ACCESS_KEY_ID=change-this-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=change-this-access-key-secret

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Supavisor pooler — unused by Presio (the app talks to Kong, not Postgres
# directly), kept so the upstream stack boots unchanged.
############
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=presio
POOLER_DB_POOL_SIZE=5

############
# Studio dashboard
############
STUDIO_DEFAULT_ORGANIZATION=Presio
STUDIO_DEFAULT_PROJECT=Presio
OPENAI_API_KEY=

############
# Edge Functions — unused by Presio.
############
FUNCTIONS_VERIFY_JWT=false

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# imgproxy / API gateway
############
IMGPROXY_AUTO_WEBP=true
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# Umami analytics (self-hosted)
# UMAMI_HOST → bare hostname Traefik routes to (no scheme).
# After first boot log in at https://${UMAMI_HOST} with admin / umami,
# change the password, add a website, and paste the generated tracking
# script into client/index.html.
############
UMAMI_HOST=analytics.presio.xyz
UMAMI_DB_PASSWORD=change-this-umami-db-password
UMAMI_APP_SECRET=change-this-to-a-random-secret-string
